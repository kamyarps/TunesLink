<Application
    x:Class="TunesLinkBridge.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="CanvasColor">#FF0C0C12</Color>
                    <Color x:Key="SurfaceColor">#FF16161E</Color>
                    <Color x:Key="RaisedSurfaceColor">#FF23232E</Color>
                    <Color x:Key="PrimaryTextColor">#FFF7F7FA</Color>
                    <Color x:Key="SecondaryTextColor">#FF9C9CA8</Color>
                    <Color x:Key="SeparatorColor">#FF2E2E3A</Color>
                    <Color x:Key="AccentTextColor">#FFFF86A3</Color>
                    <Color x:Key="SuccessColor">#FF5AD978</Color>
                    <Color x:Key="DangerColor">#FFFF6B65</Color>
                    <Color x:Key="OnBrandTextColor">#FFFFFFFF</Color>
                    <Color x:Key="SuccessTintColor">#FF162B1D</Color>
                    <Color x:Key="DangerTintColor">#FF321518</Color>
                    <Color x:Key="AccentTintColor">#FF272138</Color>
                    <Color x:Key="HeroAccentStartColor">#FFFF6B8F</Color>
                    <Color x:Key="HeroAccentMidColor">#FF9D7BFF</Color>
                    <Color x:Key="HeroAccentEndColor">#FF5EA0FF</Color>
                    <Color x:Key="AmbientAColor">#4CB34DDE</Color>
                    <Color x:Key="AmbientBColor">#3A3D6FF2</Color>
                    <Color x:Key="AmbientEdgeColor">#26FF4D8F</Color>
                    <Color x:Key="RingLineColor">#24FFFFFF</Color>
                    <Color x:Key="WarmSpotColor">#59FFB27D</Color>
                    <Color x:Key="DeviceShadowColor">#66000000</Color>
                    <Color x:Key="ScreenStartColor">#FFF0836A</Color>
                    <Color x:Key="ScreenMidColor">#FF9C57EE</Color>
                    <Color x:Key="ScreenEndColor">#FF3E6FF0</Color>
                    <LinearGradientBrush x:Key="PrimaryFillBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#FFD91E5B" Offset="0" />
                        <GradientStop Color="#FF7A4BE8" Offset="0.55" />
                        <GradientStop Color="#FF2E63D9" Offset="1" />
                    </LinearGradientBrush>
                    <Thickness x:Key="PrimaryBorderThickness">0</Thickness>
                    <Thickness x:Key="DangerBorderThickness">0</Thickness>
                    <SolidColorBrush x:Key="ButtonStateBorderPointerOverBrush" Color="{ThemeResource SeparatorColor}" />
                    <x:Double x:Key="StateLayerHoverOpacity">0.08</x:Double>
                    <x:Double x:Key="StateLayerPressedOpacity">0.14</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="CanvasColor">#FFF6F6F9</Color>
                    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
                    <Color x:Key="RaisedSurfaceColor">#FFEFEFF4</Color>
                    <Color x:Key="PrimaryTextColor">#FF131316</Color>
                    <Color x:Key="SecondaryTextColor">#FF55555E</Color>
                    <Color x:Key="SeparatorColor">#FFE4E4EB</Color>
                    <Color x:Key="AccentTextColor">#FFB91C45</Color>
                    <Color x:Key="SuccessColor">#FF147A34</Color>
                    <Color x:Key="DangerColor">#FFB42318</Color>
                    <Color x:Key="OnBrandTextColor">#FFFFFFFF</Color>
                    <Color x:Key="SuccessTintColor">#FFE5F6EA</Color>
                    <Color x:Key="DangerTintColor">#FFFBEDEC</Color>
                    <Color x:Key="AccentTintColor">#FFEFEAFE</Color>
                    <Color x:Key="HeroAccentStartColor">#FFD01A56</Color>
                    <Color x:Key="HeroAccentMidColor">#FF7A4BE8</Color>
                    <Color x:Key="HeroAccentEndColor">#FF2E63D9</Color>
                    <Color x:Key="AmbientAColor">#3DFFD9E8</Color>
                    <Color x:Key="AmbientBColor">#36D6E8FF</Color>
                    <Color x:Key="AmbientEdgeColor">#24FFE2EC</Color>
                    <Color x:Key="RingLineColor">#20897083</Color>
                    <Color x:Key="WarmSpotColor">#59FFE3D2</Color>
                    <Color x:Key="DeviceShadowColor">#26000000</Color>
                    <Color x:Key="ScreenStartColor">#FFFFD2BF</Color>
                    <Color x:Key="ScreenMidColor">#FFE0CDFF</Color>
                    <Color x:Key="ScreenEndColor">#FFBCDFFF</Color>
                    <LinearGradientBrush x:Key="PrimaryFillBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#FFD91E5B" Offset="0" />
                        <GradientStop Color="#FF7A4BE8" Offset="0.55" />
                        <GradientStop Color="#FF2E63D9" Offset="1" />
                    </LinearGradientBrush>
                    <Thickness x:Key="PrimaryBorderThickness">0</Thickness>
                    <Thickness x:Key="DangerBorderThickness">0</Thickness>
                    <SolidColorBrush x:Key="ButtonStateBorderPointerOverBrush" Color="{ThemeResource SeparatorColor}" />
                    <x:Double x:Key="StateLayerHoverOpacity">0.06</x:Double>
                    <x:Double x:Key="StateLayerPressedOpacity">0.11</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="CanvasColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="SurfaceColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="RaisedSurfaceColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="PrimaryTextColor" ResourceKey="SystemColorWindowTextColor" />
                    <StaticResource x:Key="SecondaryTextColor" ResourceKey="SystemColorWindowTextColor" />
                    <StaticResource x:Key="SeparatorColor" ResourceKey="SystemColorWindowTextColor" />
                    <StaticResource x:Key="AccentTextColor" ResourceKey="SystemColorHighlightColor" />
                    <StaticResource x:Key="SuccessColor" ResourceKey="SystemColorWindowTextColor" />
                    <StaticResource x:Key="DangerColor" ResourceKey="SystemColorWindowTextColor" />
                    <StaticResource x:Key="OnBrandTextColor" ResourceKey="SystemColorHighlightTextColor" />
                    <StaticResource x:Key="SuccessTintColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="DangerTintColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="AccentTintColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="HeroAccentStartColor" ResourceKey="SystemColorHighlightColor" />
                    <StaticResource x:Key="HeroAccentMidColor" ResourceKey="SystemColorHighlightColor" />
                    <StaticResource x:Key="HeroAccentEndColor" ResourceKey="SystemColorHighlightColor" />
                    <Color x:Key="AmbientAColor">#00000000</Color>
                    <Color x:Key="AmbientBColor">#00000000</Color>
                    <Color x:Key="AmbientEdgeColor">#00000000</Color>
                    <Color x:Key="RingLineColor">#00000000</Color>
                    <Color x:Key="WarmSpotColor">#00000000</Color>
                    <Color x:Key="DeviceShadowColor">#00000000</Color>
                    <StaticResource x:Key="ScreenStartColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="ScreenMidColor" ResourceKey="SystemColorWindowColor" />
                    <StaticResource x:Key="ScreenEndColor" ResourceKey="SystemColorWindowColor" />
                    <!-- High contrast: the primary action uses the system highlight pair (never
                         the brand gradient), states show as borders rather than translucent tints,
                         and every button keeps a visible edge. -->
                    <SolidColorBrush x:Key="PrimaryFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <Thickness x:Key="PrimaryBorderThickness">2</Thickness>
                    <Thickness x:Key="DangerBorderThickness">1</Thickness>
                    <SolidColorBrush x:Key="ButtonStateBorderPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <x:Double x:Key="StateLayerHoverOpacity">0</x:Double>
                    <x:Double x:Key="StateLayerPressedOpacity">0</x:Double>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="CanvasBrush" Color="{ThemeResource CanvasColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SurfaceColor}" />
            <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="{ThemeResource RaisedSurfaceColor}" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{ThemeResource PrimaryTextColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SecondaryTextColor}" />
            <SolidColorBrush x:Key="SeparatorBrush" Color="{ThemeResource SeparatorColor}" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="{ThemeResource AccentTextColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SuccessColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource DangerColor}" />
            <SolidColorBrush x:Key="OnBrandTextBrush" Color="{ThemeResource OnBrandTextColor}" />
            <SolidColorBrush x:Key="SuccessTintBrush" Color="{ThemeResource SuccessTintColor}" />
            <SolidColorBrush x:Key="DangerTintBrush" Color="{ThemeResource DangerTintColor}" />
            <SolidColorBrush x:Key="AccentTintBrush" Color="{ThemeResource AccentTintColor}" />
            <SolidColorBrush x:Key="DeviceShadowBrush" Color="{ThemeResource DeviceShadowColor}" />
            <RadialGradientBrush x:Key="ScreenWarmBrush" Center="0.2,0.1"
                                 RadiusX="0.75" RadiusY="0.75" GradientOrigin="0.2,0.1">
                <GradientStop Color="{ThemeResource WarmSpotColor}" Offset="0" />
                <GradientStop Color="#00000000" Offset="1" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0.85,1">
                <GradientStop Color="#42FFFFFF" Offset="0" />
                <GradientStop Color="#12FFFFFF" Offset="0.34" />
                <GradientStop Color="#00FFFFFF" Offset="0.58" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#FFD91E5B" Offset="0" />
                <GradientStop Color="#FF7A4BE8" Offset="0.55" />
                <GradientStop Color="#FF2E63D9" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HeroAccentBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="{ThemeResource HeroAccentStartColor}" Offset="0" />
                <GradientStop Color="{ThemeResource HeroAccentMidColor}" Offset="0.5" />
                <GradientStop Color="{ThemeResource HeroAccentEndColor}" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ScreenGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{ThemeResource ScreenStartColor}" Offset="0" />
                <GradientStop Color="{ThemeResource ScreenMidColor}" Offset="0.5" />
                <GradientStop Color="{ThemeResource ScreenEndColor}" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-15" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-5" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="BodyStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="ValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="SecondaryStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
            </Style>
            <Style x:Key="HeroDetailStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
            </Style>
            <Style x:Key="CardLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SeparatorBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="22" />
            </Style>
            <Style x:Key="ChipStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SeparatorBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- Tonal, icon, and danger buttons keep their own colors in every state. Hover and
                 press lay a thin tint of the button's text color over its fill (the Android
                 state layer), so a red Forget button stays red instead of turning Fluent grey. -->
            <ControlTemplate x:Key="StateLayerButtonTemplate" TargetType="Button">
                <Grid x:Name="RootGrid"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="{TemplateBinding CornerRadius}">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="StateLayer.Opacity" Value="{ThemeResource StateLayerHoverOpacity}" />
                                    <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource ButtonStateBorderPointerOverBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="StateLayer.Opacity" Value="{ThemeResource StateLayerPressedOpacity}" />
                                    <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource ButtonStateBorderPointerOverBrush}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="RootGrid.Background" Value="{ThemeResource ButtonBackgroundDisabled}" />
                                    <Setter Target="RootGrid.BorderBrush" Value="{ThemeResource ButtonBorderBrushDisabled}" />
                                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundDisabled}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border x:Name="StateLayer" Background="{TemplateBinding Foreground}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0" IsHitTestVisible="False" />
                    <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                      Foreground="{TemplateBinding Foreground}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </ControlTemplate>
            <Style x:Key="TonalButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Background" Value="{ThemeResource RaisedSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SeparatorBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
                <Setter Property="Template" Value="{StaticResource StateLayerButtonTemplate}" />
            </Style>
            <Style x:Key="TonalToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Background" Value="{ThemeResource RaisedSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SeparatorBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="PrimaryToggleButtonStyle" TargetType="ToggleButton"
                   BasedOn="{StaticResource TonalToggleButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource PrimaryFillBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource PrimaryBorderThickness}" />
                <Setter Property="Foreground" Value="{ThemeResource OnBrandTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="20,10" />
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource TonalButtonStyle}">
                <Setter Property="MinWidth" Value="44" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
            </Style>
            <Style x:Key="SettingsFlyoutPresenterStyle" TargetType="FlyoutPresenter">
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SeparatorBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource TonalButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource DangerTintBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource DangerBorderThickness}" />
                <Setter Property="Foreground" Value="{ThemeResource DangerBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
